  deploy-to-ecs:
    name: Deploy to ECS
    runs-on: ubuntu-latest

    needs: build-and-push

    steps:

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ${{ secrets.AWS_REGION }}

      - name: Set ECS image URI
        run: |
          SHORT_SHA="${GITHUB_SHA::7}"
          SHORT_TAG="v-$SHORT_SHA"

          IMAGE_FULL_URI="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO_NAME}:${SHORT_TAG}"

          echo "IMAGE_FULL_URI=$IMAGE_FULL_URI" >> "$GITHUB_ENV"

          echo "=========================================="
          echo "ECS IMAGE"
          echo "=========================================="
          echo "Git SHA   : $GITHUB_SHA"
          echo "Short SHA : $SHORT_SHA"
          echo "Image URI : $IMAGE_FULL_URI"
          echo "=========================================="

      - name: Verify image URI
        run: |
          echo "IMAGE_FULL_URI=[$IMAGE_FULL_URI]"

          if [ -z "$IMAGE_FULL_URI" ]; then
            echo "ERROR: IMAGE_FULL_URI is empty!"
            exit 1
          fi

          echo "Image URI is valid."
